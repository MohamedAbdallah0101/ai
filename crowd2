import cv2
import numpy as np
from ultralytics import YOLO
from google.colab.patches import cv2_imshow
from google.colab import drive

drive.mount('/content/drive')

# Load YOLOv8 model
model = YOLO("yolov8n.pt")  # Using YOLOv8 nano

# Load video file
video_path = "/content/drive/MyDrive/peoplecount1.mp4"
cap = cv2.VideoCapture(video_path)

# Ensure the video file was opened successfully
if not cap.isOpened():
    print("Error: Could not open video!")
    exit()

# Get video properties
frame_width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
frame_height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
fps = int(cap.get(cv2.CAP_PROP_FPS))

# Set up the output video file
output_path = "/content/drive/MyDrive/output_video.mp4"
fourcc = cv2.VideoWriter_fourcc(*'mp4v')
out = cv2.VideoWriter(output_path, fourcc, fps, (frame_width, frame_height))

# Perform object tracking with YOLO
results = model.track(source=video_path, show=True, persist=True)

# Process the results
for frame_idx, result in enumerate(results):
    frame = result.orig_img  # Get the original frame
    people_count = 0
    
    for box in result.boxes:
        cls = int(box.cls[0])  # Convert class index to integer
        if cls == 0:  # Class 0 is 'person' in COCO dataset
            people_count += 1
            x1, y1, x2, y2 = map(int, box.xyxy[0])  # Get bounding box coordinates
            cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)  # Draw bounding box
    
    # Display the person count on the frame
    cv2.putText(frame, f"People: {people_count}", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)
    
    # Show the frame
    cv2_imshow(frame)
    
    # Save the frame to the output video file
    out.write(frame)

cap.release()
out.release()
cv2.destroyAllWindows()
print(f"Output video saved at: {output_path}")
